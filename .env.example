# =============================================================================
# Perfume Website — local environment
# =============================================================================
# NEXT_PUBLIC_* vars are inlined into the browser bundle at BUILD time, so
# restart the dev server (or rebuild) after editing this file.
# Anything WITHOUT the NEXT_PUBLIC_ prefix stays server-side only — never add
# that prefix to a real secret such as CLOUDINARY_API_SECRET.
# This file is gitignored via `.env*` and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (Auth + Firestore + Analytics)  — Console > Project settings > General
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Cloudinary (unsigned product-image uploads) — Console > Settings > Upload presets
# -----------------------------------------------------------------------------
# The upload preset must exist in this Cloudinary account and its Signing Mode
# must be "Unsigned" — the browser uploads directly with no server signature.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server-side only — NOT used by any current code (uploads are unsigned).
# Kept here for future signed/admin operations. Never prefix these NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — nodemailer is installed but currently unused.
# Uncomment and fill in only if/when order-confirmation email is implemented.
# These are real secrets: server-side only, NO NEXT_PUBLIC_ prefix.
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

# -----------------------------------------------------------------------------
# OPTIONAL — payments. Checkout collects card / Easypaisa / JazzCash details but
# does NOT call any payment gateway; it only writes the order to Firestore.
# Add gateway credentials here when a real integration is wired up.
# -----------------------------------------------------------------------------
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=

# -----------------------------------------------------------------------------
# Firebase Admin (server only) — Console > Project settings > Service accounts
# -----------------------------------------------------------------------------
# "Generate new private key" gives a JSON file. Paste the whole thing on one
# line, or base64-encode it if your host mangles newlines. This key bypasses all
# security rules, so it must never be given a NEXT_PUBLIC_ prefix.
FIREBASE_SERVICE_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# Email — resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Comma separated. Every address here is emailed when an order is placed.
ADMIN_EMAILS=
# Until a sending domain is verified, Resend's test sender only delivers to the
# address that owns the Resend account.
EMAIL_FROM=onboarding@resend.dev

# -----------------------------------------------------------------------------
# WhatsApp — international format, no + and no spaces (923001234567)
# -----------------------------------------------------------------------------
# Leave blank to hide every WhatsApp affordance rather than ship a dead link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
