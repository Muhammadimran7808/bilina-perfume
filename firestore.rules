rules_version = '2';

// Paste this into: Firebase Console > Firestore Database > Rules > Publish.
// This file is the source of truth — edit it here, then copy it across.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Roles are read from the caller's own profile document. A user can never
    // write their own role (see the /users rules), so this cannot be forged.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- User profiles -------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // First sign-in creates the profile, always at the lowest privilege.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'user';

      // Profile edits must leave `role` untouched; promotion to admin happens
      // out of band in the Firebase console.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // --- Product catalogue ---------------------------------------------------
    // Public storefront reads; only admins may add, edit or remove products.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Orders --------------------------------------------------------------
    // Orders are written only by POST /api/orders, which uses the Admin SDK and
    // bypasses these rules. Clients may never create one: the browser cannot be
    // trusted with prices, and the previous rule allowed a guest order with
    // userId null, which let anyone on the internet write arbitrary documents
    // into this collection.
    match /orders/{orderId} {
      allow create: if false;

      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow update: if isAdmin();
      allow delete: if false;
    }

    // --- Coupons -------------------------------------------------------------
    // Read and applied server-side only, so codes are not enumerable from the
    // browser. They used to be a hardcoded map printed on the checkout page.
    match /coupons/{code} {
      allow read, write: if isAdmin();
    }

    // --- Newsletter subscribers ----------------------------------------------
    // Written only by POST /api/subscribe via the Admin SDK. Clients get no
    // access at all, so the mailing list cannot be harvested.
    match /subscribers/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not matched above is denied by default.
  }
}
